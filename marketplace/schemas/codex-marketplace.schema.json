{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:mcp-studio:schema:codex-marketplace",
  "title": ".agents/plugins/marketplace.json — Codex catalog",
  "description": "Codex plugin catalog. policy.authentication has NO \"NONE\" value — omit the field entirely for a no-auth entry. Spec: https://developers.openai.com/codex/plugins/build (enums verified 2026-07-02).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "interface", "plugins"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "interface": {
      "type": "object",
      "required": ["displayName"],
      "properties": { "displayName": { "type": "string", "minLength": 1 } }
    },
    "plugins": { "type": "array", "items": { "$ref": "#/definitions/entry" } }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$", "maxLength": 64 },
        "source": {
          "oneOf": [
            { "type": "string", "pattern": "^\\./(?!.*\\.\\.)[^\\s]*$" },
            {
              "type": "object",
              "required": ["source"],
              "properties": { "source": { "enum": ["local", "url", "git-subdir"] } }
            }
          ]
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "installation": { "enum": ["AVAILABLE", "INSTALLED_BY_DEFAULT", "NOT_AVAILABLE"] },
            "authentication": {
              "enum": ["ON_INSTALL", "ON_FIRST_USE"],
              "description": "There is no \"NONE\" — omit this field for a no-auth entry."
            }
          }
        }
      }
    }
  }
}
